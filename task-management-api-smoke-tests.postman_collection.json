{
  "info": {
    "name": "Task Management API Smoke Tests",
    "description": "Generic task-management API examples. Configure the environment and adapt routes and assertions to the application under test.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authenticate test user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login returns a successful response', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "const response = pm.response.json();",
              "pm.expect(response.token, 'response token').to.be.a('string').and.not.empty;",
              "pm.collectionVariables.set('token', response.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "response": []
    },
    {
      "name": "Create a task",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Task is created', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "const response = pm.response.json();",
              "pm.expect(response.data || response).to.have.property('title');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"{{taskTitle}}\",\n  \"description\": \"Sample task created by an API smoke test\",\n  \"status\": \"todo\",\n  \"priority\": \"medium\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/tasks"
      },
      "response": []
    },
    {
      "name": "List tasks",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Task list returns a successful response', function () {",
              "  pm.expect(pm.response.code).to.eql(200);",
              "  const response = pm.response.json();",
              "  pm.expect(response.data || response).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/tasks"
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "testEmail",
      "value": "qa.user@example.test"
    },
    {
      "key": "testPassword",
      "value": "SET_IN_LOCAL_POSTMAN_ENVIRONMENT"
    },
    {
      "key": "taskTitle",
      "value": "QA smoke test task"
    },
    {
      "key": "token",
      "value": ""
    }
  ]
}

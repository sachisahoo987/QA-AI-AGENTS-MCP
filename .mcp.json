{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\path\\to\\application-under-test"
      ]
    },
    "rest-api": {
      "command": "npx",
      "args": [
        "-y",
        "dkmaker-mcp-rest-api"
      ],
      "env": {
        "REST_BASE_URL": "http://localhost:3000",
        "HEADER_Accept": "application/json"
      }
    },
    "mysql": {
      "command": "uvx",
      "args": [
        "mysql_mcp_server"
      ],
      "env": {
        "MYSQL_HOST": "localhost",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "qa_test_user",
        "MYSQL_PASSWORD": "REPLACE_WITH_LOCAL_TEST_DATABASE_PASSWORD",
        "MYSQL_DATABASE": "qa_task_app"
      }
    }
  }
}
